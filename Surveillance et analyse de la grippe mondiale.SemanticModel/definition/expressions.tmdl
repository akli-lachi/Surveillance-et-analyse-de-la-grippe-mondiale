expression 'InfluenzaData_2022-2024-gerer les null' = ```
		let
		    Source = InfluenzaData,
		
		    // 📌 Filtrage des années 2022, 2023 et 2024
		    #"Lignes filtrées" = Table.SelectRows(Source, each ([ISO_YEAR] = 2022 or [ISO_YEAR] = 2023 or [ISO_YEAR] = 2024)),
		
		    // 📌 Sélection des colonnes essentielles
		    #"Colonnes sélectionnées" = Table.SelectColumns(#"Lignes filtrées",
		        {"WHOREGION", "FLUSEASON", "HEMISPHERE", "COUNTRY_AREA_TERRITORY", 
		         "ISO_WEEKSTARTDATE", "ORIGIN_SOURCE", "SPEC_PROCESSED_NB", 
		         "SPEC_RECEIVED_NB", "AH1N12009", "AH1", "AH3", "ANOTSUBTYPED", "INF_B", 
		         "INF_ALL", "INF_NEGATIVE", "ILI_ACTIVITY"}),
		
		    // 📌 Renommage des colonnes
		    #"Colonnes renommées" = Table.RenameColumns(#"Colonnes sélectionnées",{
		        {"WHOREGION", "OMS_Region"},
		        {"COUNTRY_AREA_TERRITORY", "Pays"},
		        {"ISO_WEEKSTARTDATE", "Date_Observation"},
		        {"ORIGIN_SOURCE", "Provenance"},
		        {"SPEC_PROCESSED_NB", "Echantillons_Analysés"},
		        {"SPEC_RECEIVED_NB", "Echantillons_Reçus"},
		        {"AH1N12009", "Virus_A(H1N1)"},
		        {"AH1", "Virus_A(H1)"},
		        {"AH3", "Virus_A(H3)"},
		        {"ANOTSUBTYPED", "Virus_A_NonSousTypé"},
		        {"FLUSEASON", "Saison"},
		        {"INF_B", "Positif_B"},
		        {"INF_ALL", "Positif_Total"},
		        {"INF_NEGATIVE", "Négatifs"}
		    }),
		
		    // 📌 Conversion des colonnes en nombre pour éviter les erreurs de type
		    #"Conversion en nombre" = Table.TransformColumnTypes(#"Colonnes renommées",{
		        {"Echantillons_Reçus", Int64.Type}, 
		        {"Echantillons_Analysés", Int64.Type}
		    }),
		
		    // 📌 Gestion des NULLS
		    #"Correction Nulls" = Table.TransformColumns(#"Conversion en nombre", {
		        {"Echantillons_Reçus", each if _ = null then 0 else _, Int64.Type},
		        {"Echantillons_Analysés", each if _ = null then 0 else _, Int64.Type}
		    }),
		
		       // 📌 Suppression des lignes incohérentes où "Echantillons_Reçus" est NULL ou 0
		    #"Suppression lignes inutiles" = Table.SelectRows(#"Correction Nulls", each 
		    ([Echantillons_Reçus] <> 0 and [Echantillons_Reçus] <> null) and 
		    ([Echantillons_Analysés] <> 0 and [Echantillons_Analysés] <> null)
		    ),
		
		      
		    // 📌 Correction des incohérences : si "Echantillons_Analysés" > "Echantillons_Reçus", on remplace
		    #"Correction incohérences" = Table.AddColumn(#"Suppression lignes inutiles", "Echantillons_Analysés_Corrigé",
		        each if [Echantillons_Analysés] > [Echantillons_Reçus] then [Echantillons_Reçus] else [Echantillons_Analysés], Int64.Type),
		
		    // 📌 Suppression de l'ancienne colonne et renommage
		    #"Suppression colonne originale" = Table.RemoveColumns(#"Correction incohérences", {"Echantillons_Analysés"}),
		    #"Renommage final" = Table.RenameColumns(#"Suppression colonne originale", {{"Echantillons_Analysés_Corrigé", "Echantillons_Analysés"}}),
		
		    // 📌 Remplacement des valeurs nulles pour les autres colonnes
		    #"Valeur remplacée1" = Table.ReplaceValue(#"Renommage final", null, 0, Replacer.ReplaceValue, 
		        {"Virus_A(H1N1)", "Positif_B", "Positif_Total", "Négatifs"}),
		
		    #"Valeur remplacée2" = Table.ReplaceValue(#"Valeur remplacée1", "", "0", Replacer.ReplaceValue, 
		        {"Virus_A(H1)", "Virus_A(H3)", "Virus_A_NonSousTypé", "ILI_ACTIVITY"}),
		
		    // 📌 Modification des types après correction
		    #"Type modifié" = Table.TransformColumnTypes(#"Valeur remplacée2",{
		        {"Négatifs", Int64.Type}, 
		        {"Positif_Total", Int64.Type}, 
		        {"Positif_B", Int64.Type}, 
		        {"Virus_A_NonSousTypé", Int64.Type}, 
		        {"Virus_A(H3)", Int64.Type}, 
		        {"Virus_A(H1)", Int64.Type}, 
		        {"Virus_A(H1N1)", Int64.Type}, 
		        {"Echantillons_Reçus", Int64.Type}, 
		        {"Echantillons_Analysés", Int64.Type}
		    }),
		
		    // 📌 Ajout de la colonne Niveau_Propagation avec valeurs textuelles
		    #"Ajout Niveau_Propagation" = Table.AddColumn(#"Type modifié", "Niveau_Propagation", each 
		        if [ILI_ACTIVITY] = "0" then "Aucune activité" 
		        else if [ILI_ACTIVITY] = "1" then "Activité sporadique" 
		        else if [ILI_ACTIVITY] = "2" then "Début localisé" 
		        else if [ILI_ACTIVITY] = "3" then "Propagation régionale" 
		        else if [ILI_ACTIVITY] = "4" then "Propagation étendue" 
		        else if [ILI_ACTIVITY] = "5" then "Niveau épidémique" 
		        else if [ILI_ACTIVITY] = "6" then "Propagation pandémique" 
		        else null),
		
		    // 📌 Suppression de la colonne ILI_ACTIVITY (inutile après transformation)
		    #"Colonnes supprimées" = Table.RemoveColumns(#"Ajout Niveau_Propagation",{"ILI_ACTIVITY"}),
		
		    // 📌 Réorganisation des colonnes pour plus de clarté
		    #"Colonnes permutées" = Table.ReorderColumns(#"Colonnes supprimées",
		        {"OMS_Region", "Saison", "HEMISPHERE", "Pays", "Date_Observation", "Provenance", 
		         "Echantillons_Analysés", "Echantillons_Reçus", "Virus_A(H1N1)", "Virus_A(H1)", "Virus_A(H3)", 
		         "Virus_A_NonSousTypé", "Positif_B", "Positif_Total", "Négatifs", "Niveau_Propagation"})
		in
		    #"Colonnes permutées"
		```
	lineageTag: bd9b77f7-2a1e-4f1c-923e-a26438dd2391
	queryGroup: verification

