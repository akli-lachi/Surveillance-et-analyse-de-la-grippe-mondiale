		    #"Personnalisée ajoutée" = Table.AddColumn(#"Type modifié", "diffrence entre reçu et analysé", each [Echantillons_Reçus]-[Echantillons_Analysés]),
		    #"Colonnes permutées" = Table.ReorderColumns(#"Personnalisée ajoutée",{"OMS_Region", "Pays", "Date_Observation", "Echantillons_Analysés", "Echantillons_Reçus", "diffrence entre reçu et analysé", "Virus_A(H1N1)", "Virus_A(H1)", "Virus_A(H3)", "Virus_A_NonSousTypé", "Positif_B", "Positif_Total", "Négatifs", "ILI_ACTIVITY"}),
		    #"Lignes triées1" = Table.Sort(#"Colonnes permutées",{{"diffrence entre reçu et analysé", Order.Ascending}}),
		    #"Lignes filtrées1" = Table.SelectRows(#"Lignes triées1", each ([diffrence entre reçu et analysé] <> null)),
