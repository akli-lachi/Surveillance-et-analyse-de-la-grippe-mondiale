	partition Datum = calculated
		mode: import
		source = ```
				
				ADDCOLUMNS (
				    CALENDAR (DATE(2022,1,1), DATE(2024,12,31)),  
				    "Année", YEAR([Date]),
				    "Mois", FORMAT([Date], "MMM"),  
				    "Mois_Complet", FORMAT([Date], "MMMM"),  
				    "Numero_Mois", MONTH([Date]),  
				    "Année-Mois", FORMAT([Date], "YYYY-MM"), 
				    "Semaine", WEEKNUM([Date], 2)  
				)
				
				```

	annotation PBI_Id = 5e4edafbe23647d5a610a52ba8378846

